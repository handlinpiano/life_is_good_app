# Frontend (Vite)
VITE_API_URL=http://127.0.0.1:8000/api
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Optional: show /dev-login in production builds (still needs Convex TEST_AUTH_*)
# VITE_ENABLE_TEST_AUTH=true

# --- Convex dashboard / `npx convex env set` (not VITE_) ---
# Run: node scripts/setup-test-auth.mjs --apply --secret 'your-secret'
# TEST_AUTH_SECRET=your-secret
# TEST_JWT_PRIVATE_KEY_B64=...
# TEST_AUTH_ISSUER=https://your-deployment.convex.site
# TEST_AUTH_JWKS_URL=https://your-deployment.convex.site/.well-known/jwks.json
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev
